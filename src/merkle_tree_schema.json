{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "MerkleTreeExport",
  "description": "JSON schema for hash-based Merkle Tree export",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "description": "Schema version for compatibility",
      "default": "1.0"
    },
    "nodes": {
      "type": "array",
      "description": "Array of tree nodes in level-order (breadth-first)",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-fA-F]{64}$",
        "description": "Hex-encoded hash of a node (64 hex chars = 32 bytes)"
      }
    },
    "nodes_count": {
      "type": "integer",
      "minimum": 0,
      "description": "Total number of nodes in the tree"
    },
    "leaves_count": {
      "type": "integer",
      "minimum": 0,
      "description": "Number of leaf nodes (original data)"
    },
    "tree_depth": {
      "type": "integer",
      "minimum": 0,
      "description": "Depth of the tree (0 for empty tree)"
    },
    "hashalgo": {
      "type": "string",
      "description": "Hashing algorithm used",
      "enum": ["sha256", "blake2b", "keccak256", "md5", "sha1", "custom"],
      "default": "sha256"
    },
    "root_hash": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$",
      "description": "Hex-encoded root hash (same as nodes[0] if tree is not empty)"
    },
    "metadata": {
      "type": "object",
      "description": "Additional metadata about the tree",
      "properties": {
        "created_at": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 timestamp of tree creation"
        },
        "hash_size": {
          "type": "integer",
          "minimum": 1,
          "description": "Size of hash in bytes (e.g., 32 for SHA256)",
          "default": 32
        },
        "algorithm_info": {
          "type": "string",
          "description": "Additional algorithm or implementation details"
        },
        "original_data_type": {
          "type": "string",
          "description": "Type of original data that was hashed",
          "examples": ["binary", "text", "json", "integers", "custom"]
        }
      },
      "additionalProperties": true
    }
  },
  "required": ["nodes", "nodes_count", "hashalgo"],
  "additionalProperties": false,
  "examples": [
    {
      "version": "1.0",
      "nodes": [
        "a1b2c3d4e5f6789012345678901234567890123456789012345678901234abcd",
        "1234567890abcdef1234567890abcdef1234567890abcdef1234567890abcdef",
        "abcdef1234567890abcdef1234567890abcdef1234567890abcdef1234567890"
      ],
      "nodes_count": 3,
      "leaves_count": 2,
      "tree_depth": 1,
      "hashalgo": "sha256",
      "root_hash": "a1b2c3d4e5f6789012345678901234567890123456789012345678901234abcd",
      "metadata": {
        "created_at": "2025-10-19T12:00:00Z",
        "hash_size": 32,
        "algorithm_info": "SHA256-based CBMT",
        "original_data_type": "integers"
      }
    }
  ]
}